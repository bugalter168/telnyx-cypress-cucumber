{
  "name": "telnyx-cypress-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress + Cucumber + TypeScript UI test suite for telnyx.com",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "test:local": "cypress run --config-file cypress.config.ts --browser chrome --headed",
    "test:ci": "cypress run --config-file cypress.ci.config.ts --browser electron",
    "test:smoke": "cypress run --config-file cypress.config.ts --browser chrome --headed --env tags=@smoke",
    "open": "cypress open --config-file cypress.config.ts",
    "report:generate": "node scripts/allure.mjs generate",
    "report:open": "node scripts/allure.mjs open",
    "clean": "node scripts/allure.mjs clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test-plan:generate": "node test-plan/generate-test-plan.mjs"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.43.0",
    "allure-cypress": "^3.10.2",
    "cypress": "^15.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "diff": "^8.0.3"
  },
  "allowScripts": {
    "cypress": true,
    "esbuild": true
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.steps.ts"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  }
}
